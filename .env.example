# =============================================================================
#  MISS UNIVERSE NAIL ART STUDIO — Environment Configuration
# =============================================================================
#  Copy this file to ".env" and edit the values.
#  The setup script does this for you automatically and generates a SECRET_KEY.
#  NEVER commit your real .env file to version control.
# =============================================================================

# ---- Application environment: "development" or "production" -----------------
ENV=development

# ---- Security ---------------------------------------------------------------
# A long random string used to sign login sessions & CSRF tokens.
# The setup script generates one for you. To rotate it, replace the value with
# a new random string (this will log out the admin).
SECRET_KEY=change-me-to-a-long-random-string
# How long an admin stays logged in (minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- First admin account ----------------------------------------------------
# The app creates this admin automatically on first run if no admin exists.
# CHANGE THESE before going live.
ADMIN_NAME=Studio Admin
ADMIN_EMAIL=admin@missuniverse.local
ADMIN_PASSWORD=ChangeMe!123

# ---- Database ---------------------------------------------------------------
# Default: local SQLite file (zero setup).
DATABASE_URL=sqlite:///./nailstudio.db
# For PostgreSQL (production) use e.g.:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/nailstudio
# For MySQL:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/nailstudio

# ---- Studio branding (shown across the public site) -------------------------
STUDIO_NAME=Miss Universe
STUDIO_SUBTITLE=Nail Art Studio
STUDIO_TAGLINE=Elegance at Your Fingertips
STUDIO_DESCRIPTION=Premium bespoke nail art designs — bridal, chrome, French, 3D and more. Discover your perfect nail style.

# ---- Contact & WhatsApp -----------------------------------------------------
# WhatsApp number in FULL international format, digits only (no +, spaces or dashes).
# Example for India +91 98765 43210  ->  919876543210
WHATSAPP_NUMBER=919876543210
CONTACT_EMAIL=hello@missuniverse.local
CONTACT_PHONE=+91 98765 43210
CONTACT_ADDRESS=123 Glamour Lane, Your City
INSTAGRAM_URL=https://instagram.com/
FACEBOOK_URL=https://facebook.com/

# ---- Currency ---------------------------------------------------------------
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹

# ---- Public base URL (used for SEO tags, sitemap, Open Graph) ---------------
# Development: leave as localhost. LIVE site: set to your real https:// domain,
# e.g. BASE_URL=https://www.yourstudio.com
BASE_URL=http://localhost:8000

# ---- Going live (only needed when deploying — see docs/DEPLOY_ORACLE.md) ----
# Your domain name, with NO "http://" or path, e.g. DOMAIN=www.yourstudio.com
# The production stack (docker-compose.prod.yml) uses this to fetch a FREE
# HTTPS certificate automatically. Leave blank while developing locally.
DOMAIN=

# ---- Image uploads ----------------------------------------------------------
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=5
# Comma-separated list of allowed image extensions.
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp

# ---- Login rate limiting (brute-force protection) ---------------------------
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
