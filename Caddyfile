# =============================================================================
#  Miss Universe Nail Art Studio — Caddy reverse proxy
# =============================================================================
#  Caddy sits in front of your app and does one magical job: it automatically
#  fetches and renews a FREE HTTPS certificate (the padlock 🔒) for your domain,
#  then forwards visitors to the app running privately on port 8000.
#
#  You do NOT edit this file. Your domain comes from the DOMAIN value in .env.
# =============================================================================

{$DOMAIN} {
	# Compress responses so pages load faster.
	encode zstd gzip

	# Forward all traffic to the app container (named "web") on its port 8000.
	reverse_proxy web:8000
}
